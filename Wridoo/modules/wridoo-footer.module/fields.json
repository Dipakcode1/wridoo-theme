    "default": [
      { "network": "Facebook", "url": "#!" },
      { "network": "Twitter", "url": "#!" },
      { "network": "LinkedIn", "url": "#!" },
      { "network": "Instagram", "url": "#!" }
    ]
  },
  {
    "name": "copyright_text",
    "label": "Copyright Text",
    "type": "text",
    "default": "Wridoo, All rights reserved."
  },
  {
    "name": "terms_url",
    "label": "Terms of Service URL",
    "type": "text",
    "default": "#!"
  },
  {
    "name": "privacy_url",
    "label": "Privacy Policy URL",
    "type": "text",
    "default": "#!"
  }
]
